{
  "name": "integration-replay-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "preview": "wrangler dev --ip 127.0.0.1 --port 8790 --local",
    "db:migrate:local": "wrangler d1 migrations apply integration-replay-lab --local",
    "db:migrate:remote": "wrangler d1 migrations apply integration-replay-lab --remote",
    "deploy": "npm run build && wrangler deploy",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build && npm run build:cli && npm run test:cli",
    "build:cli": "vite build --ssr src/cli.ts --outDir dist-cli",
    "replay": "node dist-cli/cli.js",
    "test:cli": "node --test tests/cli.test.mjs",
    "audit:dependencies": "npm audit --audit-level=high",
    "lint": "eslint src worker --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage": "vitest run --coverage",
    "record:walkthrough": "node scripts/record-walkthrough.mjs",
    "prepare:walkthrough": "node scripts/prepare-walkthrough.mjs",
    "preview:walkthrough": "node scripts/serve-walkthrough.mjs",
    "verify:recovery": "node scripts/recovery-rehearsal.mjs",
    "verify:live": "node scripts/verify-live-api.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/workers-types": "5.20260917.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "wrangler": "4.133.0"
  }
}
