{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "integration-replay-lab",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-17",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "integration-replay-lab",
      "database_id": "e63837fb-ecef-43e2-8d44-2d8bcfb3aeb2",
      "migrations_dir": "migrations",
      "preview_database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
  "triggers": {
    "crons": ["17 3 * * *"],
  },
  "ratelimits": [
    {
      "name": "WRITE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
  },
  "vars": {
    "APP_VERSION": "1.0.0",
  },
  "account_id": "9fa6b3dd10d11d3dee396ec7e58e49f7",
}
